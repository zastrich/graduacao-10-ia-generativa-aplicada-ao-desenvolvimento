# =============================================================================
# SECRETS — GitHub Actions
# =============================================================================
# Registre cada variável abaixo em:
#   GitHub → Settings → Secrets and variables → Actions → New repository secret
# =============================================================================


# -----------------------------------------------------------------------------
# AWS CREDENTIALS (usadas nos 3 workflows: infra, backend e frontend)
# -----------------------------------------------------------------------------

# Chave de acesso da conta/usuário IAM com permissões de deploy.
# Como gerar:
#   1. Acesse o AWS IAM Console → Users → selecione (ou crie) um usuário de CI.
#   2. Aba "Security credentials" → "Create access key" → use case "Other".
#   3. Copie o "Access key ID" gerado.
# Permissões mínimas necessárias para o usuário IAM:
#   AmazonS3FullAccess, AmazonDynamoDBFullAccess, AWSLambdaFullAccess,
#   AmazonAPIGatewayAdministrator, AWSCloudFormationFullAccess,
#   IAMFullAccess, AmazonBedrockFullAccess, AmazonRoute53FullAccess
AWS_ACCESS_KEY_ID=

# Chave secreta correspondente ao AWS_ACCESS_KEY_ID acima.
# Como gerar:
#   Mesmos passos do AWS_ACCESS_KEY_ID — a "Secret access key" é exibida
#   apenas uma vez no momento da criação. Guarde-a imediatamente.
AWS_SECRET_ACCESS_KEY=

# Segredo usado para assinar e validar os JWTs de autenticação da aplicação.
# Como gerar:
#   Execute no terminal:
#     node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   ou:
#     openssl rand -hex 64
#   Use um valor diferente e único para cada ambiente (dev/staging/prod).
#   NUNCA use o valor default em produção.
JWT_SECRET=

# ARN do certificado ACM que cobre os domínios WEB_URL e API_URL.
# Para domínios *.example.com, use um certificado wildcard.
# O certificado DEVE estar em us-east-1 (requisito do CloudFront).
# Como obter:
#   1. AWS Console → Certificate Manager → região us-east-1
#   2. Copie o ARN do certificado que cobre seu domínio.
#   Formato: arn:aws:acm:us-east-1:<ACCOUNT_ID>:certificate/<UUID>
CERTIFICATE_ARN=


# =============================================================================
# VARIABLES — GitHub Actions
# =============================================================================
# Registre cada variável abaixo em:
#   GitHub → Settings → Secrets and variables → Actions → Variables tab
# =============================================================================


# -----------------------------------------------------------------------------
# REGIÃO E AMBIENTE
# -----------------------------------------------------------------------------

# Região AWS onde os recursos serão criados.
# Todas as pipelines usam essa variável. Não há região hardcoded.
AWS_REGION=us-east-1

# Stage de deploy: dev | staging | prod
# O valor influencia o nome de todos os recursos AWS criados.
DEPLOY_STAGE=prod


# -----------------------------------------------------------------------------
# DOMÍNIOS E DNS (Route53)
# -----------------------------------------------------------------------------

# Subdomínio para o frontend (ex: copiloto-corporativo.code200.com.br).
# Um registro A (Alias → CloudFront) será criado automaticamente no Route53.
WEB_URL=copiloto-corporativo.code200.com.br

# Subdomínio para a API (ex: copiloto-corporativo-api.code200.com.br).
# IMPORTANTE: deve ser coberto pelo certificado ACM. Se usar wildcard *.example.com,
# o subdomínio deve ter apenas um nível (ex: app-api.example.com, NÃO api.app.example.com).
# Um registro A (Alias → API Gateway Custom Domain) será criado automaticamente.
API_URL=copiloto-corporativo-api.code200.com.br

# ID da Hosted Zone no Route53 onde os registros DNS serão criados.
# Como obter:
#   1. AWS Console → Route53 → Hosted Zones
#   2. Copie o "Hosted zone ID" da zona do seu domínio.
#   Formato: Z0851491YVAOB1BFAMS (string alfanumérica)
#   IMPORTANTE: A zona DEVE existir previamente. A pipeline NÃO cria a zona.
HOSTED_ZONE_ID=

# Origem permitida para CORS da API.
# Após configurar o domínio, use: https://<WEB_URL>
# Exemplo: https://copiloto-corporativo.code200.com.br
ALLOWED_ORIGIN=https://copiloto-corporativo.code200.com.br


# -----------------------------------------------------------------------------
# FRONTEND DEPLOY
# -----------------------------------------------------------------------------

# URL da API usada pelo frontend (Vite inject em build time).
# Se não definida, o workflow usa https://<API_URL> automaticamente.
# Formato: https://api.copiloto-corporativo.code200.com.br
VITE_API_URL=

# Nome do bucket S3 onde o build do frontend será sincronizado.
# Formato: copiloto-frontend-<stage>
FRONTEND_S3_BUCKET=copiloto-frontend-prod

# ID da distribuição CloudFront para invalidação de cache.
# Como obter: Outputs da stack CloudFormation ou AWS CloudFront Console.
# Formato: E1XXXXXXXXXXXXX
CLOUDFRONT_DISTRIBUTION_ID=


# =============================================================================
# VARIÁVEIS DE AMBIENTE — Desenvolvimento Local (não são secrets do GitHub)
# =============================================================================
# As variáveis abaixo são usadas apenas ao rodar a aplicação localmente.
# NÃO precisam ser cadastradas no GitHub Actions.
# =============================================================================

# Indica ao backend que está rodando localmente (fora do Lambda).
IS_LOCAL=true

# Porta do servidor local do backend.
PORT=3001

# ID do modelo Bedrock usado para inferência.
BEDROCK_MODEL_ID=google.gemma-3-4b-it

# Nomes das tabelas DynamoDB para o ambiente de desenvolvimento local.
KNOWLEDGE_BASES_TABLE=copiloto-knowledge-bases-dev
CONVERSATIONS_TABLE=copiloto-conversations-dev
MESSAGES_TABLE=copiloto-messages-dev
USERS_TABLE=copiloto-users-dev

# Nome do bucket S3 de conhecimento para desenvolvimento local.
KNOWLEDGE_BUCKET=conhecimento-ia-generativa-dev
